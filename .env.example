# Copia este archivo como .env y completa con los valores reales.
# .env NUNCA debe subirse a git ni quedar accesible por el webroot público.

# --- cPanel (autenticación por usuario/contraseña, vía UAPI) ---
CPANEL_HOST=servidor.tu-hosting.cl
CPANEL_PORT=2083
CPANEL_USER=usuario_cpanel
CPANEL_PASS=contraseña_cpanel
CPANEL_VERIFY_SSL=true

# Dominio donde se crean los correos de expediente
CPANEL_DOMAIN=chiledao.cl
CPANEL_QUOTA_MB=250

# --- Envío del correo de notificación al solicitante ---
MAIL_FROM=soporte@chiledao.cl
MAIL_FROM_NAME="Los Inmortales"

# URL de Webmail a incluir en el correo de credenciales.
# https://webmail.chiledao.cl solo funciona si existe ese subdominio/proxy AutoSSL apuntando al cpsrvd.
# Si no lo has configurado, usa el puerto nativo de cPanel: https://chiledao.cl:2096
WEBMAIL_URL=https://webmail.chiledao.cl

# --- API para el agente (wiki-de-salud, Vercel) ---
# Clave NUEVA y distinta de la de api.php. Generarla larga y aleatoria.
AGENTE_API_KEY=pon_aqui_una_clave_larga_aleatoria
